{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowJs": false,
		"types": [],
		"baseUrl": "."
	},
	"include": ["src/**/*.ts"]
}
