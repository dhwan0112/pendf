{
  "name": "pendf",
  "version": "0.8.0",
  "private": true,
  "description": "Standalone, iPad-first PDF viewer and annotator for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "pnpm typecheck && eslint . && node scripts/check-standalone.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "smoke:webkit": "node scripts/webkit/make-collide.mjs && node scripts/webkit/smoke.mjs --browsers webkit,chromium --b06"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "26.6.6",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-obsidianmd": "0.5.1",
    "jsdom": "26.1.0",
    "magic-string": "0.30.21",
    "obsidian": "1.14.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist-core": "npm:pdfjs-dist@5.3.31",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
