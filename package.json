{
  "name": "pendf",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, iPad-first PDF viewer and annotator for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "pnpm typecheck && node scripts/check-standalone.mjs",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@types/node": "26.6.6",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "magic-string": "0.30.21",
    "obsidian": "1.14.4",
    "pdf-lib": "1.17.1",
    "postcss": "8.5.32",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
